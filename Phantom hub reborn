                WAITING = "WAITING", RAGDOLLED_RUSH = "RAGDOLLED_RUSH",
                MOVING_TO_BEST = "MOVING_TO_BEST", COLLECTING_BEST = "COLLECTING_BEST",
                RETURNING = "RETURNING", DEPOSITING = "DEPOSITING", WAITING_RESET = "WAITING_RESET",
        },
