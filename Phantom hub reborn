                        local tab = setmetatable({
                                _window = win, _pill = pill, _label = label, _stroke = pillStroke,
                                _page = page, _list = list, _rows = {}, _name = name,
                        }, Tab)


                        local function select()
                                if win._activeTab == tab then return end
                                local prev = win._activeTab
                                win._activeTab = tab
                                win._activePage = page
                                if prev then
                                        prev._page.Visible = false
                                        tween(prev._pill, { BackgroundColor3 = C.Element })
                                        tween(prev._label, { TextColor3 = C.TextGray })
                                        prev._stroke.Color = C.Border
                                end
                                page.Visible = true
                                activePage = page
                                win._activePage = page
                                tween(pill, { BackgroundColor3 = C.AccentDim })
                                tween(label, { TextColor3 = C.White })
                                pillStroke.Color = C.Accent
                        end


                        pill.MouseButton1Click:Connect(select)
                        pill.MouseEnter:Connect(function()
                                if win._activeTab ~= tab then tween(pill, { BackgroundColor3 = C.ElementHover }) end
                        end)
                        pill.MouseLeave:Connect(function()
                                if win._activeTab ~= tab then tween(pill, { BackgroundColor3 = C.Element }) end
                        end)


                        table.insert(self._tabs, tab)
                        if not self._activeTab then select() end
                        return tab
                end


                function Window:SetProfileVisible() return false end
                function Window:ToggleProfile() return false end
                function Window:SetUIVisible(v)
                        self._uiVisible = v ~= false
                        self._IconBtn.Visible = self._uiVisible
                        self.Container.Visible = self._uiVisible and (self.Main.Visible ~= false) and isOpen
                        return self._uiVisible
                end
                function Window:SetShowFpsOnIcon(v)
                        showFpsOnIcon = v == true
                        if self._IconFpsLabel then self._IconFpsLabel.Visible = showFpsOnIcon end
                end
                function Window:SetShowPingOnIcon(v)
                        showPingOnIcon = v == true
                        if self._IconPingLabel then self._IconPingLabel.Visible = showPingOnIcon end
                end
                function Window:SetFPSCap(v)
                        local cap = tonumber(v) or 0
                        if type(setfpscap) == "function" then pcall(setfpscap, cap) end
                end
                function Window:SetIconSize(size)
                        size = tonumber(size)
                        if size and self._IconBtn then self._IconBtn.Size = UDim2.fromOffset(size, size) end
                end
                function Window:SetIconShape(shape)
                        if not self._IconBtn then return end
                        local old = self._IconBtn:FindFirstChildOfClass("UICorner")
                        if old then old:Destroy() end
                        local c = Instance.new("UICorner")
                        c.CornerRadius = (shape == "Box") and UDim.new(0, 14) or UDim.new(1, 0)
                        c.Parent = self._IconBtn
                end
                function Window:SetAccentPreset(name)
                        local presets = {
                                Cyan={96,150,244,26,46,82}, Blue={96,150,244,26,46,82},
                                Purple={150,90,240,60,26,100}, Pink={240,100,180,110,30,80},
                                Red={230,90,90,100,26,26}, Green={90,220,130,26,100,60},
                                Yellow={240,200,80,110,90,26}, White={220,220,240,80,85,100},
                        }
                        local p = presets[name]
                        if not p then return end
                        C.Accent = Color3.fromRGB(p[1],p[2],p[3])
                        C.AccentDim = Color3.fromRGB(p[4],p[5],p[6])
                        if self._mainGlowStroke then self._mainGlowStroke.Color = C.Accent end
                        if self._IconStroke then self._IconStroke.Color = C.Accent end
                end
                function Window:ToggleUI() return self:SetUIVisible(not self._uiVisible) end
                function Window:SetScale(v)
                        v = math.clamp(tonumber(v) or 1, 0.5, 1.5)
                        self._containerScale.Scale = v
                        return v
                end
                function Window:GetScale() return self._containerScale.Scale end
                function Window:SetVisible(v) self.ScreenGui.Enabled = v == true end
                function Window:Toggle() self.ScreenGui.Enabled = not self.ScreenGui.Enabled end


                function Window:Destroy()
                        self._destroyed = true
                        for _, c in ipairs(self._connections or {}) do pcall(function() c:Disconnect() end) end
                        table.clear(self._connections or {})
                        local i = table.find(Lib._windows, self.ScreenGui)
                        if i then table.remove(Lib._windows, i) end
                        local j = table.find(Lib._windowObjects, self)
                        if j then table.remove(Lib._windowObjects, j) end
                        if self.ScreenGui then self.ScreenGui:Destroy() end
                        if self._Blur then self._Blur:Destroy() end
                end


                function Window:SetLogo(id)
                        self._logoAsset = normalizeAssetId(id) or self._logoAsset
                        return self._logoAsset
                end


                table.insert(Lib._windowObjects, windowObj)
                return windowObj
        end


