function Steal.isPlayerRagdolled()
        local hum = findHum(); if not hum then return false end
        local ok, s = pcall(function() return hum:GetState() end)
        if not ok then return false end
        return s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.Ragdoll
                or s == Enum.HumanoidStateType.FallingDown
end
function Steal.resetCarryDetection() end
function Steal.instantFirePrompt(prompt)
        if not prompt or not prompt.Parent then return end
        pcall(function()
                local h = prompt.HoldDuration
                prompt.HoldDuration = 0
                if fireproximityprompt then fireproximityprompt(prompt) end
                prompt.HoldDuration = h
        end)
end
function Steal.findCarryPromptNear(pos, radius)
        radius = radius or 14
        local best, bestD = nil, math.huge
        for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Name == "CarryAreaEgg" and d.Enabled then
                        local act = (d.ActionText or ""):lower()
                        local obj = (d.ObjectText or ""):lower()
                        if not act:find("skip") and not act:find("robux")
                                and not obj:find("skip") and not obj:find("robux") then
                                local p = d.Parent
                                if p and p:IsA("Attachment") then p = p.Parent end
                                if p then
                                        local dist = (p.Position - pos).Magnitude
                                        if dist < radius and dist < bestD then best, bestD = d, dist end
                                end
                        end
                end
        end
        return best
end
function Steal.isAreaSealed() return false end
function Steal.getMatchingEggByUid(uid)
        if not uid then return nil end
        for _, e in ipairs(GetMatchingFieldEggs(selectedStealAreas, selectedStealRarities, selectedMutationTypes)) do
                if e.record.Uid == uid then return e end
        end
        return nil
end
function Steal.pickNearestEgg()
        local hrp = findHRP(); if not hrp then return nil end
        local nearest, nD = nil, math.huge
        for _, e in ipairs(GetMatchingFieldEggs(selectedStealAreas, selectedStealRarities, selectedMutationTypes)) do
                local d = (hrp.Position - e.record.BoundsCFrame.Position).Magnitude
                if d < nD then nearest, nD = e, d end
        end
        return nearest
end
function Steal.pickBestEgg()
        return GetMatchingFieldEggs(selectedStealAreas, selectedStealRarities, selectedMutationTypes)[1]
end
function Steal.travelTo(pos, speed, isApproach)
        if avoidTrapsEnabled then pcall(NeutralizeTraps) end
        pcall(TravelToDestination, pos, speed, isApproach)
        local hrp = findHRP()
        if hrp then
                hrp.CFrame = CFrame.new(pos)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
        end
end


