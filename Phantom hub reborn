        -- Config persistence
        local function hasFileApi()
                return type(writefile) == "function" and type(readfile) == "function"
        end
        local function ensureConfigFolder()
                if type(makefolder) ~= "function" or type(isfolder) ~= "function" then return end
                local path = ""
                for _, part in ipairs(string.split(Lib.ConfigFolder, "/")) do
                        if part ~= "" then
                                path = (path == "") and part or (path .. "/" .. part)
                                if not isfolder(path) then pcall(makefolder, path) end
                        end
                end
        end
        local function configPath(name)
                name = tostring(name or "default"):gsub("[^%w%-_ ]", "")
                if name == "" then name = "default" end
                return Lib.ConfigFolder .. "/" .. name .. ".json"
        end
        function Lib:GetConfig()
                local d = {}
                for flag, e in pairs(Lib.Flags) do
                        if e.api then
                                local ok, v
                                if e.kind == "color" and type(e.api.GetHex) == "function" then
                                        ok, v = pcall(e.api.GetHex, e.api)
                                elseif type(e.api.Get) == "function" then
                                        ok, v = pcall(e.api.Get, e.api)
                                end
                                if ok and v ~= nil then
                                        if e.kind == "keybind" then
                                                d[flag] = (typeof(v) == "EnumItem") and v.Name or false
                                        else
                                                d[flag] = v
                                        end
                                end
                        end
                end
                return d
        end
        function Lib:LoadConfigData(data)
                if type(data) ~= "table" then return false end
                Lib._autoSaveDisabled = true
                for flag, v in pairs(data) do
                        local e = Lib.Flags[tostring(flag)]
                        if e and e.api and type(e.api.Set) == "function" then
                                if e.kind == "keybind" then
                                        local key = nil
                                        if type(v) == "string" then pcall(function() key = Enum.KeyCode[v] end) end
                                        pcall(e.api.Set, e.api, key)
                                else
                                        pcall(e.api.Set, e.api, v)
                                end
                        end
                end
                task.delay(0.2, function() Lib._autoSaveDisabled = false end)
                return true
        end
        local autoSaveThread = nil
        function Lib:QueueAutoSave()
                if Lib._autoSaveDisabled then return end
                if not hasFileApi() then return end
                local cfgName = Lib._currentConfigName or "autoload"
                if autoSaveThread then pcall(task.cancel, autoSaveThread); autoSaveThread = nil end
                autoSaveThread = task.delay(0.6, function()
                        autoSaveThread = nil
                        pcall(function() Lib:SaveConfig(cfgName) end)
                end)
        end
        function Lib:SaveConfig(name)
                if not hasFileApi() then return false end
                ensureConfigFolder()
                local ok, enc = pcall(function() return HttpService:JSONEncode(Lib:GetConfig()) end)
                if not ok then return false end
                return (pcall(writefile, configPath(name), enc))
        end
        function Lib:LoadConfig(name)
                if not hasFileApi() then return false end
                local path = configPath(name)
                if type(isfile) == "function" and not isfile(path) then return false end
                local ok, raw = pcall(readfile, path)
                if not ok or not raw then return false end
                local dec, data = pcall(function() return HttpService:JSONDecode(raw) end)
                if not dec then return false end
                return Lib:LoadConfigData(data)
        end
        function Lib:ListConfigs()
                local out = {}
                if type(listfiles) ~= "function" then return out end
                ensureConfigFolder()
                local ok, files = pcall(listfiles, Lib.ConfigFolder)
                if not ok or type(files) ~= "table" then return out end
                for _, f in ipairs(files) do
                        local n = string.match(tostring(f), "([^/\\]+)%.json$")
                        if n then table.insert(out, n) end
                end
                return out
        end
        function Lib:DeleteConfig(name)
                if type(delfile) ~= "function" then return false end
                return (pcall(delfile, configPath(name)))
        end


