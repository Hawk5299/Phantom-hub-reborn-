        function Lib:SetState(k, v)
                k = tostring(k); Lib.State[k] = v
                if Lib._stateListeners[k] then
                        for _, fn in ipairs(Lib._stateListeners[k]) do pcall(fn, v) end
                end
                return v
        end
        function Lib:GetState(k, d) local v = Lib.State[tostring(k)]; return v == nil and d or v end
        function Lib:BindState(k, fn)
                k = tostring(k)
                Lib._stateListeners[k] = Lib._stateListeners[k] or {}
                table.insert(Lib._stateListeners[k], fn)
                if Lib.State[k] ~= nil then pcall(fn, Lib.State[k]) end
                return fn
        end
        function Lib:Get(flag, d)
                local e = Lib.Flags[tostring(flag)]
                if e and e.api and e.api.Get then local v = e.api.Get(); if v ~= nil then return v end end
                return Lib.State[tostring(flag)] ~= nil and Lib.State[tostring(flag)] or d
        end
        function Lib:Set(flag, v)
                local e = Lib.Flags[tostring(flag)]
                if e and e.api and e.api.Set then pcall(e.api.Set, e.api, v); return true end
                Lib:SetState(tostring(flag), v); return true
        end
        function Lib:GetFlag(flag, d) return Lib:Get(flag, d) end
        function Lib:SetFlag(flag, v) return Lib:Set(flag, v) end


        local function registerFlag(flag, kind, api)
                if flag ~= nil and api then
                        Lib.Flags[tostring(flag)] = { kind = kind, api = api }
                        if Lib.State[tostring(flag)] ~= nil and api.Set then
                                pcall(function() api:Set(Lib.State[tostring(flag)]) end)
                        end
                end
                return api
        end


        local THEME_PROPS = { "BackgroundColor3", "TextColor3", "PlaceholderColor3",
