                        if t:IsA("Model") and (t.Name:lower():find("egg")
                                or t:GetAttribute("Uid") or t:GetAttribute("AssetCategory")) then return true end
                        if t:IsA("Tool") then
                                if EggToolDisplay and EggToolDisplay.IsEggTool and EggToolDisplay.IsEggTool(t) then return true end
                                if t:GetAttribute("IsEgg") == true or t:GetAttribute("Uid") ~= nil
                                        or t:GetAttribute("AssetCategory") ~= nil then return true end
                                local n = t.Name:lower()
                                if n:find("egg") or (n ~= "bat" and n ~= "defaulttool" and not n:find("bat")
                                        and not n:find("slap") and not n:find("coil") and not n:find("potion")
                                        and not n:find("lantern")) then return true end
