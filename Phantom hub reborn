                                tween(pill, { BackgroundColor3 = value and C.AccentDim or C.Badge })
                                tween(knob, { BackgroundColor3 = value and C.KnobAccent or C.KnobOff, Position = kp })
                                tween(pillOutline, { Color = value and C.AccentBright or C.Border })
                        else
                                pill.BackgroundColor3 = value and C.AccentDim or C.Badge
                                knob.BackgroundColor3 = value and C.KnobAccent or C.KnobOff
                                knob.Position = kp
                                pillOutline.Color = value and C.AccentBright or C.Border
                        end
                end
                local function set(v)
                        v = v == true
                        if v == value then return end
                        value = v
                        render(true)
                        fire(opts.Callback, value)
                        Lib:QueueAutoSave()
                end
                pill.MouseButton1Click:Connect(function() set(not value) end)
                render(false)


                return registerFlag(opts.Flag, "toggle",
                        { Set = function(_, v) set(v) end, Get = function() return value end })
