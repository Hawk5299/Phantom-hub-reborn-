        function Lib:SetTheme(theme)
                local name
                if type(theme) == "string" then
                        name = theme; theme = Lib.Themes[theme]
                        if not theme then warn("unknown theme " .. tostring(name)); return false end
                end
                for k, v in pairs(theme) do
                        if typeof(v) == "Color3" then C[k] = v end
                end
                Lib._currentTheme = name or "Custom"
                rebuildReverse()
                for _, sg in ipairs(Lib._windows) do
                        if sg and sg.Parent then
                                for _, inst in ipairs(sg:GetDescendants()) do
                                        local goal
                                        for _, prop in ipairs(THEME_PROPS) do
                                                local key = inst:GetAttribute("Theme_" .. prop)
                                                if key and C[key] then
                                                        goal = goal or {}
                                                        goal[prop] = C[key]
                                                end
                                        end
                                        if goal then tween(inst, goal) end
                                end
                        end
                end
                return true
        end
